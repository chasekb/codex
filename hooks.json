{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/TaskStart\"",
            "timeout": 30,
            "statusMessage": "Loading global workflow state"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/TaskResume\"",
            "timeout": 30,
            "statusMessage": "Restoring global workflow state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/PreToolUse\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/PreCompact\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/PostToolUse\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/Notification\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/UserPromptSubmit\"",
            "timeout": 30
          }
        ]
      }
    ],
    "TaskCancel": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/TaskCancel\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$HOME/.codex/hooks/TaskComplete\"",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
